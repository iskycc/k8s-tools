<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.iskycc</groupId>
  <artifactId>k8s-tools</artifactId>
  <version>1.6.2-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>k8s-tools</name>
  <description>
    Java 8 Kubernetes 工具库：通用资源 CRUD、Patch/Apply、Discovery、分页和子资源，
    支持直接 Bearer Token 或 SSH 获取凭据，附本地 HTTPS/SSH 模拟测试。
  </description>
  <url>https://github.com/iskycc/k8s-tools</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>iskycc</id>
      <name>iskycc</name>
      <url>https://github.com/iskycc</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/iskycc/k8s-tools.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/iskycc/k8s-tools.git</developerConnection>
    <url>https://github.com/iskycc/k8s-tools</url>
  </scm>

  <properties>
    <!-- 目标运行时为 JDK8：本机使用 JDK21 编译，release=8 保证字节码与 API 均为 Java 8 级别 -->
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- 2026-09-20 核对：选用支持 Java 8 的最新稳定依赖，不使用 alpha/beta/RC。 -->
    <gson.version>2.14.0</gson.version>
    <junit.version>4.13.2</junit.version>
    <hamcrest.version>3.0</hamcrest.version>
    <sshd.version>2.19.0</sshd.version>
    <bouncycastle.version>1.86</bouncycastle.version>
    <slf4j.version>2.0.19</slf4j.version>
    <httpclient.version>5.6.4</httpclient.version>
    <nv-websocket.version>2.14</nv-websocket.version>
    <okhttp.version>5.5.0</okhttp.version>
    <okio.version>3.18.2</okio.version>
    <kotlin.version>2.4.20</kotlin.version>
    <!-- Jedis 按接入要求固定为 5.2.0，其余新增运行组件保持 Java 8 兼容。 -->
    <jedis.version>5.2.0</jedis.version>
    <commons-pool2.version>2.13.1</commons-pool2.version>
    <json.version>20260814</json.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>redis.clients</groupId>
      <artifactId>jedis</artifactId>
      <version>${jedis.version}</version>
      <exclusions>
        <!-- Gson 已直接声明，避免其静态分析注解经 Jedis 的另一条依赖路径进入下游。 -->
        <exclusion>
          <groupId>com.google.code.gson</groupId>
          <artifactId>gson</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- 直接声明 Jedis 的必需组件，保证使用方也选择已验证版本；dependencyManagement 不向下游传递。 -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-pool2</artifactId>
      <version>${commons-pool2.version}</version>
    </dependency>
    <dependency>
      <groupId>org.json</groupId>
      <artifactId>json</artifactId>
      <version>${json.version}</version>
    </dependency>
    <!-- Java 8 原生 HttpURLConnection 不支持 PATCH；使用 HttpClient 执行真实 HTTP 方法。 -->
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <version>${httpclient.version}</version>
    </dependency>
    <!-- Pod Exec：独立 WebSocket 客户端，不自动重试握手，无额外传递依赖。 -->
    <dependency>
      <groupId>com.neovisionaries</groupId>
      <artifactId>nv-websocket-client</artifactId>
      <version>${nv-websocket.version}</version>
    </dependency>
    <!-- 以下仅用于 WebSocket 模拟服务，不进入使用方运行依赖。 -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp-jvm</artifactId>
      <version>${okhttp.version}</version>
      <scope>test</scope>
      <exclusions>
        <exclusion><groupId>org.jetbrains</groupId><artifactId>annotations</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.squareup.okio</groupId>
      <artifactId>okio-jvm</artifactId>
      <version>${okio.version}</version>
      <scope>test</scope>
      <exclusions>
        <exclusion><groupId>org.jetbrains</groupId><artifactId>annotations</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>${kotlin.version}</version>
      <scope>test</scope>
      <exclusions>
        <!-- 仅供静态分析使用，不属于 WebSocket 的运行能力。 -->
        <exclusion><groupId>org.jetbrains</groupId><artifactId>annotations</artifactId></exclusion>
      </exclusions>
    </dependency>
    <!-- SSH 客户端(Apache MINA SSHD)：登录 master 节点执行 kubectl 获取 service token -->
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-core</artifactId>
      <version>${sshd.version}</version>
      <exclusions>
        <!-- SSHD 使用 SLF4J API；本库不使用 Commons Logging，不向使用方注入日志桥接。 -->
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>jcl-over-slf4j</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- 直接声明日志 API，确保使用方不会因传递依赖路径而退回上游声明的 1.7.x。 -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <!-- CLI 默认输出 INFO 日志；optional 避免向使用方强制传递日志实现。 -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>

    <!-- JSON 解析 k8s API 响应 -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
      <exclusions>
        <!-- 仅供 Error Prone 静态分析使用，JSON 运行功能不需要，不向下游传递。 -->
        <exclusion>
          <groupId>com.google.errorprone</groupId>
          <artifactId>error_prone_annotations</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- ==================== 以下为测试(E2E 模拟)依赖 ==================== -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver3</artifactId>
      <version>${okhttp.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
      <exclusions>
        <!-- JUnit 4 默认带入旧 hamcrest-core；改用兼容 Java 8 的 Hamcrest 3。 -->
        <exclusion>
          <groupId>org.hamcrest</groupId>
          <artifactId>hamcrest-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest</artifactId>
      <version>${hamcrest.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- 动态生成自签名证书：模拟 kube-apiserver 的 HTTPS 证书与 CA -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.iskycc.k8s.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- 仅显式启用时连接一次性真实集群；普通 test/发布构建仍只运行本地模拟测试。 -->
    <profile>
      <id>real-e2e</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>3.2.5</version>
            <configuration>
              <includes><include>**/RealKubernetesIT.java</include></includes>
              <systemPropertyVariables>
                <k8s.tools.realE2e>true</k8s.tools.realE2e>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <goals><goal>integration-test</goal><goal>verify</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- 快照使用标准 Maven 仓库协议；只有显式激活才允许上传。 -->
    <profile>
      <id>snapshot</id>
      <distributionManagement>
        <snapshotRepository>
          <id>central</id>
          <name>Central Portal Snapshots</name>
          <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
      </distributionManagement>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>require-snapshot-version</id>
                <goals><goal>enforce</goal></goals>
                <configuration>
                  <rules>
                    <requireProperty>
                      <property>project.version</property>
                      <regex>(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-SNAPSHOT</regex>
                      <regexMessage>快照发布必须使用 X.Y.Z-SNAPSHOT 版本。</regexMessage>
                    </requireProperty>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <configuration>
              <bestPractices>true</bestPractices>
              <passphraseEnvName>MAVEN_GPG_PASSPHRASE</passphraseEnvName>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-deploy-plugin</artifactId>
            <version>3.1.4</version>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- 仅显式发布时生成附属产物、签名并启用 Central Portal 部署。 -->
    <profile>
      <id>release</id>
      <properties>
        <central.skipPublishing>false</central.skipPublishing>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>require-release-version</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireReleaseVersion>
                      <message>Central 发布必须使用正式版本，请先将 POM 版本设置为待发布版本。</message>
                    </requireReleaseVersion>
                    <requireReleaseDeps/>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <configuration>
              <bestPractices>true</bestPractices>
              <passphraseEnvName>MAVEN_GPG_PASSPHRASE</passphraseEnvName>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <!-- 上传完成即结束构建，后续校验与发布由 Central 自动处理。 -->
              <waitUntil>uploaded</waitUntil>
              <skipPublishing>${central.skipPublishing}</skipPublishing>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
